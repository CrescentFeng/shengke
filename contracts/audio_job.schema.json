{
  "$defs": {
    "JobEvent": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/JobState"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        }
      },
      "required": [
        "state"
      ],
      "title": "JobEvent",
      "type": "object"
    },
    "JobState": {
      "enum": [
        "pending",
        "validating",
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "JobState",
      "type": "string"
    },
    "Operation": {
      "enum": [
        "probe",
        "normalize",
        "vad",
        "loudness",
        "denoise",
        "transcribe",
        "diarize",
        "classify",
        "synthesize"
      ],
      "title": "Operation",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "input_uri": {
      "title": "Input Uri",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/Operation"
      },
      "title": "Operations",
      "type": "array"
    },
    "policy_id": {
      "title": "Policy Id",
      "type": "string"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "state": {
      "$ref": "#/$defs/JobState",
      "default": "pending"
    },
    "progress": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Progress",
      "type": "number"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/JobEvent"
      },
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "input_uri",
    "operations",
    "policy_id",
    "idempotency_key"
  ],
  "title": "AudioJob",
  "type": "object"
}
