{
  "$defs": {
    "TranscriptSpan": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "format": "uuid",
          "title": "Segment Id",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "speaker": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        }
      },
      "required": [
        "segment_id",
        "start_ms",
        "end_ms",
        "text"
      ],
      "title": "TranscriptSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "backend": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Backend",
      "type": "string"
    },
    "model": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "language": {
      "anyOf": [
        {
          "maxLength": 32,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "language_confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language Confidence"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "spans": {
      "items": {
        "$ref": "#/$defs/TranscriptSpan"
      },
      "title": "Spans",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "backend",
    "model",
    "text"
  ],
  "title": "TranscriptDocument",
  "type": "object"
}
