AUDIO_PLATFORM_ENV=development
AUDIO_PLATFORM_HOST=0.0.0.0
AUDIO_PLATFORM_PORT=8000
AUDIO_PLATFORM_FFMPEG=ffmpeg
AUDIO_PLATFORM_FFPROBE=ffprobe
AUDIO_PLATFORM_MAX_UPLOAD_BYTES=1073741824
AUDIO_PLATFORM_ALLOWED_INPUT_ROOT=/data/input
AUDIO_PLATFORM_ARTIFACT_ROOT=/data/artifacts
AUDIO_PLATFORM_DATABASE_URL=postgresql://audio:audio@postgres:5432/audio_platform
AUDIO_PLATFORM_S3_ENDPOINT=http://localhost:9000
AUDIO_PLATFORM_S3_REGION=us-east-1
AUDIO_PLATFORM_S3_ACCESS_KEY=audioadmin
AUDIO_PLATFORM_S3_SECRET_KEY=change-me-now
AUDIO_PLATFORM_S3_ARTIFACT_BUCKET=audio-artifacts
AUDIO_PLATFORM_S3_INPUT_BUCKET=audio-input
AUDIO_PLATFORM_S3_USE_SSL=false
AUDIO_PLATFORM_WORKER_POLL_SECONDS=2
AUDIO_PLATFORM_WORKER_STALE_AFTER_SECONDS=900
AUDIO_PLATFORM_WORKER_ID=ingest-worker-1
AUDIO_PLATFORM_POSTGRES_PORT=55433
AUDIO_PLATFORM_EXTRAS=asr-whisper,diarization-pyannote
AUDIO_PLATFORM_ASR_BACKEND=faster-whisper
AUDIO_PLATFORM_ASR_MODEL=small
AUDIO_PLATFORM_ASR_DEVICE=cpu
AUDIO_PLATFORM_ASR_COMPUTE_TYPE=int8
AUDIO_PLATFORM_ASR_BEAM_SIZE=5
AUDIO_PLATFORM_ASR_LANGUAGE=
AUDIO_PLATFORM_DIARIZATION_BACKEND=pyannote
AUDIO_PLATFORM_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
AUDIO_PLATFORM_DIARIZATION_DEVICE=cpu
# Prefer this read-only host token file for Docker Compose. Do not commit its contents.
AUDIO_PLATFORM_HF_TOKEN_HOST_PATH=
# Optional for a non-Compose worker process. Never place a real value in tracked files.
AUDIO_PLATFORM_HF_TOKEN=
# Optional when Docker cannot directly reach model/package hosts.
AUDIO_PLATFORM_HTTP_PROXY=
AUDIO_PLATFORM_HTTPS_PROXY=
